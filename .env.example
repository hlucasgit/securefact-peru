# Copy to .env for local development. NEVER commit .env. Values below are local-only placeholders.
SF_ENVIRONMENT=Local

# Host ports (chosen to avoid clashing with common local services)
SF_API_PORT=5180
SF_WEB_PORT=5173
SF_POSTGRES_PORT=55432
SF_REDIS_PORT=56379
SF_RABBITMQ_PORT=55672
SF_RABBITMQ_MGMT_PORT=15672
SF_S3_PORT=58000

POSTGRES_DB=securefact
POSTGRES_USER=securefact_owner
POSTGRES_PASSWORD=change-me-local-owner
# Runtime role used by the app: no BYPASSRLS, not table owner (ADR-003).
SF_APP_DB_USER=securefact_app
SF_APP_DB_PASSWORD=change-me-local-app

REDIS_PASSWORD=change-me-local-redis

RABBITMQ_DEFAULT_USER=securefact
RABBITMQ_DEFAULT_PASS=change-me-local-rabbit

# S3-compatible dev store (SeaweedFS). Ports 59000-59114 are reserved by Windows/Hyper-V on some machines.
S3_ACCESS_KEY=securefact-s3
S3_SECRET_KEY=change-me-local-s3-secret
SF_STORAGE_BUCKET=securefact-documents

# Signing key for access tokens (base64, at least 32 bytes). Generate: openssl rand -base64 48
SF_JWT_SIGNING_KEY=

# SUNAT channel of the API and the workers: empty = documents are prepared and signed but not sent; Sandbox = the in-process simulator (ADR-039), for development and demos;
# Beta = SUNAT's test service (functional tests only, never load). Production is never chosen implicitly.
SF_SUNAT_ENVIRONMENT=

# Optional: OTLP collector for traces/metrics (e.g. http://otel:4317 with --profile observability)
SF_OTLP_ENDPOINT=

# Local-only key-encryption key for ADR-007 (base64, 32 bytes). Rejected in Production.
# Generate: openssl rand -base64 32
SF_LOCAL_DEV_KEK=
